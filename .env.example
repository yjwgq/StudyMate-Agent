# ============================================================
#  Personal Agent OS — 环境变量模板
# ============================================================
#  用法：把本文件复制为 .env，填入真实值。
#        .env 已被 .gitignore 忽略，不会提交到仓库。
#
#  分节说明：
#    【M0 必需】  「应用」和「LLM」两节填好即可跑通聊天闭环
#    【M1 必需】  「数据库」「鉴权」两节填好即可跑通多租户认证
#    【后续启用】 其余分节按里程碑逐步启用，留空即可
# ============================================================


# ============================================================
#  应用                    【M0 必需】
# ============================================================
APP_ENV=dev
LOG_LEVEL=INFO
# 允许的前端来源，逗号分隔。开发期用 * 方便直连调试
CORS_ORIGINS=*


# ============================================================
#  LLM（OpenAI 兼容接口，DeepSeek / 智谱等）   【M0 必需】
# ============================================================
# 改这里无副作用，随时可更换模型（与 Embedding 不同，见 ADR-8）
# 注意 BASE_URL 与 MODEL 必须属于同一家服务商
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# ?? 请登录控制台确认「当前可用」的模型名后填入，不要照抄示例
LLM_MODEL=
LLM_TIMEOUT_S=60


# ============================================================
#  Embedding（通义千问 / DashScope 兼容模式）   【M2 起启用】
# ============================================================
# ?? 更换 Embedding 模型 = 全量重嵌入，启动自检会直接拦截
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=
# 必须与 DDL 中 chunks.embedding 的维度一致（设计文档 v1.1 §6.5）
EMBED_DIM=1024
# 单次请求文本条数上限（DashScope 兼容模式为 10）
EMBED_BATCH_SIZE=10


# ============================================================
#  知识库上传（M2）
# ============================================================
# 本地直跑默认 ./data/uploads；容器内由 compose 覆盖为 /data/uploads（共享卷）
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=50
DOC_QUOTA_PER_USER=200
PARSE_MAX_PAGES=2000
PARSE_MAX_UNZIP_MB=500

# ============================================================
#  父子分块（M2）
# ============================================================
CHUNK_PARENT_TOKENS=1024
CHUNK_CHILD_TOKENS=256
CHUNK_OVERLAP_RATIO=0.1


# ============================================================
#  Reranker                    【M6 起启用】
# ============================================================
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=


# ============================================================
#  小模型路由（意图分类 / query 改写）   【M4 起启用】
# ============================================================
LLM_SMALL_MODEL=


# ============================================================
#  PostgreSQL 与 Redis         【M1 必需】
# ============================================================
# 超级用户密码（postgres 容器初始化用；也是三角色密码，见下注）
POSTGRES_PASSWORD=
# 三个角色分离，见设计文档 v1.1 ADR-9：
#   app_api     受 RLS 约束
#   app_worker  BYPASSRLS（跨租户扫描定时任务）
#   app_owner   拥有表所有权，仅用于迁移
#
# ?? 开发环境简化：三个角色的密码统一 = POSTGRES_PASSWORD 的值。
#    把下面三条 URL 中的 CHANGE_ME 替换为你设置的 POSTGRES_PASSWORD
#    （三处相同；生产环境应各自独立强密码，由 secrets 注入）。
DATABASE_URL=postgresql+asyncpg://app_api:CHANGE_ME@postgres:5432/agent
DATABASE_URL_WORKER=postgresql+asyncpg://app_worker:CHANGE_ME@postgres:5432/agent
DATABASE_URL_MIGRATE=postgresql+asyncpg://app_owner:CHANGE_ME@postgres:5432/agent
REDIS_URL=redis://redis:6379/0


# ============================================================
#  鉴权与加密                  【M1 必需】
# ============================================================
# JWT_SECRET 生成方式：openssl rand -hex 32
# （PowerShell：-join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })）
JWT_SECRET=
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=7
# 第三方凭据加密主密钥（envelope encryption 的 KEK）【M5+ 使用】
CREDENTIAL_KEK=


# ============================================================
#  可观测（Langfuse Cloud）      【M3 起启用】
# ============================================================
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 必须为 true：trace 通道最容易漏脱敏
LANGFUSE_REDACT_PII=true


# ============================================================
#  MCP 工具                    【M4 起启用】
# ============================================================
# 白名单，禁用自动发现（见设计文档 v1.1 §13.10）
MCP_ALLOWED_SERVERS=sandbox,todo,filesystem,fetch
MCP_SANDBOX_CMD=
MCP_FILESYSTEM_ROOT=/data/agent
FETCH_DOMAIN_ALLOWLIST=


# ============================================================
#  配额与限流                   【M9 起启用】
# ============================================================
DAILY_TOKEN_BUDGET=500000
BURST_WINDOW_MIN=5
BURST_TOKEN_LIMIT=50000


# ============================================================
#  检索参数                     【M6 起启用】
# ============================================================
HYBRID_TOP_K=200
RRF_K=60
RERANK_TOP_N=6
# HyDE 软超时（毫秒）：超时即丢弃该分支，不阻塞主链路
HYDE_SOFT_TIMEOUT_MS=300
