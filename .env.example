# ============================================================
# StudyMate Agent — 环境配置模板
# ============================================================
# 使用方法：
#   1. 复制此文件，重命名为 .env
#   2. 根据实际情况修改配置项值
#   3. 切勿将 .env 提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ---- Ollama 本地模型配置 ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# ---- Chroma 向量库配置 ----
CHROMA_PERSIST_DIRECTORY=./chroma_db/

# ---- 服务端口配置 ----
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# ---- 超时配置（秒） ----
REQUEST_TIMEOUT=300
RETRIEVE_TIMEOUT=30
CALC_TIMEOUT=20
ROUTER_TIMEOUT=60
QA_TIMEOUT=120
RETRIEVE_NODE_TIMEOUT=90
REFLECTION_TIMEOUT=90

# ---- 云端模型配置 ----
# 切换开关：true=使用云端API，false=使用本地Ollama
USE_CLOUD_MODEL=false

# 云端API密钥（从阿里云 DashScope / 硅基流动 / 智谱等服务商获取）
CLOUD_API_KEY=your-cloud-api-key-here

# 云端大模型（对话）接口地址与模型名
# 阿里云通义千问示例： https://dashscope.aliyuncs.com/compatible-mode/v1
# 硅基流动示例：       https://api.siliconflow.cn/v1
# DeepSeek示例：        https://api.deepseek.com/v1
CLOUD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_LLM_MODEL_NAME=qwen-plus

# 云端向量（嵌入）接口地址与模型名
# 一般与 LLM 使用同一 base_url；部分服务商两者不同，需单独配置
CLOUD_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_EMBED_MODEL_NAME=text-embedding-v4
CLOUD_EMBED_DIMENSIONS=1024
