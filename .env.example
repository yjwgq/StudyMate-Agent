# ============================================================
#  Personal Agent OS — 环境变量模板
# ============================================================
#  用法：把本文件复制为 .env，填入真实值。
#        .env 已被 .gitignore 忽略，不会提交到仓库。
#
#  分节说明：
#    【M0 必需】  只有「应用」和「LLM」两节需要填，就能跑通端到端最小闭环
#    【后续启用】 其余分节按里程碑逐步启用，M0 阶段留空即可
# ============================================================


# ============================================================
#  应用                    【M0 必需】
# ============================================================
APP_ENV=dev
LOG_LEVEL=INFO
# 允许的前端来源，逗号分隔。开发期用 * 方便直连调试
CORS_ORIGINS=*


# ============================================================
#  LLM（DeepSeek，OpenAI 兼容接口）   【M0 必需】
# ============================================================
# 改这里无副作用，随时可更换模型（与 Embedding 不同，见 ADR-8）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
# ⚠️ 请登录控制台确认「当前可用」的模型名后填入，不要照抄示例
LLM_MODEL=
LLM_TIMEOUT_S=60


# ============================================================
#  Embedding（通义千问 / DashScope 兼容模式）   【M2 起启用】
# ============================================================
# ⚠️ 更换 Embedding 模型 = 全量重嵌入，启动自检会直接拦截
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=
# 必须与 DDL 中 chunks.embedding 的维度一致（设计文档 v1.1 §6.5）
EMBED_DIM=1024


# ============================================================
#  Reranker                    【M6 起启用】
# ============================================================
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3


# ============================================================
#  小模型路由（意图分类 / query 改写）   【M4 起启用】
# ============================================================
LLM_SMALL_MODEL=


# ============================================================
#  PostgreSQL 与 Redis         【M1 起启用】
# ============================================================
# 三个角色分离，见设计文档 v1.1 ADR-9：
#   app_api     受 RLS 约束
#   app_worker  BYPASSRLS（跨租户扫描定时任务）
#   app_owner   拥有表所有权，仅用于迁移
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://app_api:CHANGE_ME@postgres:5432/agent
DATABASE_URL_WORKER=postgresql+asyncpg://app_worker:CHANGE_ME@postgres:5432/agent
DATABASE_URL_MIGRATE=postgresql+asyncpg://app_owner:CHANGE_ME@postgres:5432/agent
REDIS_URL=redis://redis:6379/0


# ============================================================
#  鉴权与加密                  【M1 起启用】
# ============================================================
# JWT_SECRET 生成方式：openssl rand -hex 32
JWT_SECRET=
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=7
# 第三方凭据加密主密钥（envelope encryption 的 KEK）
CREDENTIAL_KEK=


# ============================================================
#  可观测（Langfuse Cloud）      【M3 起启用】
# ============================================================
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 必须为 true：trace 通道最容易漏脱敏
LANGFUSE_REDACT_PII=true


# ============================================================
#  MCP 工具                    【M4 起启用】
# ============================================================
# 白名单，禁用自动发现（见设计文档 v1.1 §13.10）
MCP_ALLOWED_SERVERS=sandbox,todo,filesystem,fetch
MCP_SANDBOX_CMD=
MCP_FILESYSTEM_ROOT=/data/agent
FETCH_DOMAIN_ALLOWLIST=


# ============================================================
#  配额与限流                   【M9 起启用】
# ============================================================
DAILY_TOKEN_BUDGET=500000
BURST_WINDOW_MIN=5
BURST_TOKEN_LIMIT=50000


# ============================================================
#  检索参数                     【M6 起启用】
# ============================================================
HYBRID_TOP_K=200
RRF_K=60
RERANK_TOP_N=6
# HyDE 软超时（毫秒）：超时即丢弃该分支，不阻塞主链路
HYDE_SOFT_TIMEOUT_MS=300
