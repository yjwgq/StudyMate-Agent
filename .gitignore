# ============================================================
# StudyMate Agent — Git 忽略规则
# ============================================================

# ---- Python 编译产物 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- uv 缓存 ----
.uv_cache/
uv_cache/

# ---- IDE 配置 ----
.idea/
.vscode/
.trae/
*.iml
*.iws
*.ipr

# ---- 环境变量（含密钥，禁止提交） ----
.env
.env.local
.env.*.local

# ---- 向量数据库（大文件，运行时生成，可重建） ----
chroma_db/

# ---- 日志文件 ----
logs/
*.log
*.log.*

# ---- HuggingFace / datasets 缓存 ----
datasets/hf_cache/
datasets/*_raw/
!datasets/*_raw/.gitkeep

# ---- 用户上传的临时文档（保留 uploads/.gitkeep 占位） ----
datasets/uploads/*
!datasets/uploads/.gitkeep

# ---- 测试文件（单元测试、联调脚本，不提交到仓库） ----
test_*.py
*_test.py

# ---- 演示 / 草稿脚本 ----
*_demo.py
graph/graph_demo.py

# ---- 系统临时文件 ----
.DS_Store
Thumbs.db
*.tmp
*.temp
