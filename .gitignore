# ============================================================
#  Personal Agent OS — Git 忽略规则
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- 虚拟环境 ----
# 注意：uv.lock 要提交（锁文件是复现构建的前提），不要忽略
.venv/
venv/
ENV/

# ---- uv 缓存 ----
.uv_cache/

# ---- Node / Next.js ----
node_modules/
.next/
out/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 环境变量（含密钥，禁止提交）----
.env
.env.local
.env.*.local

# ---- 测试与工具缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- 运行时数据（compose 卷挂载点，可重建）----
data/
logs/
*.log

# ---- 系统 ----
.DS_Store
Thumbs.db
*.tmp
*.temp

# ZCode 工具产物（plan 草稿等）
.zcode/
