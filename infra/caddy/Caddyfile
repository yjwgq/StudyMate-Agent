# ============================================================
#  Caddy —— 开发环境反向代理配置
# ============================================================
#  统一入口 8080：
#      /api/*   → api:8000   （后端，含 SSE 流式）
#      其余      → web:3000   （前端）
#
#  ⚠️ 本文件最关键的一行是 flush_interval -1
# ============================================================

:8080 {
	# ------------------------------------------------------------
	#  后端 API
	#
	#  flush_interval -1 的作用：每次写入立即 flush，禁用响应缓冲。
	#
	#  为什么必须这样：Caddy（以及 Nginx）默认会缓冲响应体，
	#  这对普通 JSON 接口无感，但对 SSE 是致命的 —— 整个流会被
	#  攒在缓冲区里，前端看到的是「转圈几十秒，然后一次性吐出全文」，
	#  「逐字输出」这个能力直接失效。
	#
	#  若改用 Nginx，等价配置为：
	#      proxy_buffering off;
	#      proxy_cache off;
	#      proxy_read_timeout 300s;
	#      chunked_transfer_encoding on;
	#
	#  后端侧另有 X-Accel-Buffering: no 响应头（见 apps/api/sse.py），
	#  两者配合，任一环节都不缓冲。
	# ------------------------------------------------------------
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# ------------------------------------------------------------
	#  前端
	# ------------------------------------------------------------
	handle {
		reverse_proxy web:3000
	}

	# 开发环境：请求日志直接打到 stdout，方便 docker compose logs 排查
	log {
		output stdout
		format console
	}
}
